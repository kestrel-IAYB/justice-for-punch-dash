<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Product>JusticeForPunchDash</Product>
    <Version>1.1.3</Version>
    <Description>Restores the punch dash bug from the IAYB demo</Description>
    <BepInExPluginGuid>kestrel.iamyourbeast.justiceforpunchdash</BepInExPluginGuid>
    <AssemblyName>$(Product)</AssemblyName>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- https://github.com/BepInEx/BepInEx.Analyzers/pull/6 oh my god PLEASE someone merge this -->
    <NoWarn>1701;1702;Harmony003;</NoWarn>
  </PropertyGroup>

  <!--
    if you would like to build this project and one or both of your BepInEx and/or game are
    not installed in the usual place, set <GameDir>/<BepInExDir> here. Remember trailing slashes!
    -->
  <Import Project="Directory.Build.local.props" Condition="Exists('Directory.Build.local.props')" />

  <PropertyGroup Condition="'$(GameDir)' == ''">
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\I Am Your Beast</GameDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BepInExDir)' == ''">
    <BepInExDir>$(GameDir)\BepInEx\</BepInExDir>
  </PropertyGroup>

  <PropertyGroup>
    <GameLibDir>$(GameDir)\I Am Your Beast_Data\Managed\</GameLibDir>
    <DevBuildDir>$(BepInExDir)plugins\dev-builds\</DevBuildDir>
  </PropertyGroup>

  <PropertyGroup>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>embedded</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=/,$(NuGetPackageRoot)=.nuget</PathMap>
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.8" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="1.1.0" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.5" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp" Publicize="true">
      <HintPath>$(GameLibDir)\Assembly-CSharp.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="CopyDllToGame" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <OldFiles Include="$(DevBuildDir)$(Product)-v*.dll" />
    </ItemGroup>
    <Delete Files="@(OldFiles)" />
    <Move SourceFiles="$(TargetDir)$(TargetName).dll" DestinationFiles="$(DevBuildDir)$(Product)-v$(Version).dll"/>
  </Target>
</Project>
